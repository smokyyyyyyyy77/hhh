{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOC 报告封面生成器",
  "version": "1.0.0",
  "identifier": "com.local.soc-cover-generator",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SOC 报告封面生成器",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
